# Copy to backend/.env and fill in. Never commit .env.
# Keep comments on their own lines: python-dotenv reads "KEY=   # note" as the value "# note".

# Single-user login (required to use the app). Change the password.
APP_USERNAME=roshan
APP_PASSWORD=change-me
# Long random string that signs the login cookie. Generate one with:
#   ../venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"
# If empty, a random key is used and every server restart logs you out.
SECRET_KEY=
# Uncomment only when the app is served over HTTPS.
# COOKIE_SECURE=1

# Optional: Claude writes the plain-English "why it was listed" text.
ANTHROPIC_API_KEY=
# NARRATION_MODEL=claude-opus-5-5

# Database (SQLite file by default; set a Postgres URL to switch)
# DATABASE_URL=sqlite:////absolute/path/to/backend/data/trade_assistant.db

# Daily monitoring job (Asia/Kolkata)
DAILY_JOB_HOUR=18
DAILY_JOB_MINUTE=30

# Paper-trading-only defaults for the research platform
PAPER_MODE=paper
STARTING_CAPITAL=100000
MAX_OPEN_POSITIONS=10
MAX_POSITION_WEIGHT=0.15
MAX_DAILY_LOSS_PCT=0.05
PER_TRADE_RISK_PCT=0.01
KILL_SWITCH=0
